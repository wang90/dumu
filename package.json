{
  "name": "dumu",
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dev:desktop": "npm run rebuild:native && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k \"npm run dev:web\" \"npm run dev:desktop\"",
    "build:web": "vite build",
    "build": "npm run build:web",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build:web && electron-builder --mac",
    "dist:dir": "npm run build:web && electron-builder --mac --dir"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.2",
    "electron-builder": "^26.7.0",
    "electron-rebuild": "^3.2.9",
    "vite": "^6.1.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.dumu.app",
    "productName": "dumu",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "dumu",
        "schemes": [
          "dumu"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    }
  }
}
